# Watcher-watcher: deadline check over TERMINAL heartbeat rows.
# Answers "is it even watching?" AND "did the watcher get watched?" —
# exit 1 when any baselined site lacks a heartbeat within cadence+grace.
# Route its failure somewhere loud, your infra's choice, e.g.:
#   OnFailure=notify-mail@%n.service   (a unit you already have), or
#   crontab: ... || /path/to/your/alert.sh "mpw monitor stale"
# Cadence must match the run timer (hourly run -> 60+30 default is fine).
# Install alongside minicpm-monitor.{service,timer}; enable its .timer too.

[Unit]
Description=minicpm-webapp staleness deadline check (fail = scheduler went silent)
# Page routing (W11 half #3): fires mpw-page@ on every red. %N (not %n):
# %n double-suffixes the instance (mpw-page@minicpm-monitor-stale.service.
# service) which made the gate's own first journal grep MISS the pager
# firing - an operator at 2 AM would conclude the pager never ran (Quinn,
# 2026-10-25 plant). Becomes live when this copy is (re)installed.
OnFailure=mpw-page@%N.service

[Service]
Type=oneshot
Environment=MPW_DIR=/root/minicpm-webapp
Environment=MPW_PY=python3
ExecStart=/bin/sh -c 'cd "$MPW_DIR" && "$MPW_PY" monitorlib.py stale --db "$MPW_DIR/baselines/runs.db" --index "$MPW_DIR/baselines/index.json" --cadence 60 --grace 30 --require-ok'
